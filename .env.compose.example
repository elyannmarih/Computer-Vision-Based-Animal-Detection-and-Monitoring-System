# Choose a password for this local PostgreSQL instance before starting Compose.
# This file does not configure Neon or a physical camera.
DETECTRA_DB_PASSWORD=replace-with-your-local-database-password
DETECTRA_WEB_PORT=3000

# Optional: your own camera, reachable from the Docker host. Keep credentials in .env.compose.
# No camera is opened by default. Scan Now saves a frame; automatic saving defaults to off.
DETECTRA_CAMERA_RTSP_URL=
DETECTRA_CAMERA_NAME=Camera
DETECTRA_CAMERA_SAVE_INTERVAL=0
