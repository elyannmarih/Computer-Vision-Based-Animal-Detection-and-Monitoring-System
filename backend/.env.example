# Local reproduction uses PostgreSQL on this machine. Neon is not required.
# A hosted Postgres URL can add sslmode=require. Do not commit the filled-in file.
DATABASE_URL=postgresql://detectra_dev:replace-me@127.0.0.1:5432/detectra_dev

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Image storage. Leave S3_BUCKET empty to store images in backend/uploads.
# Any S3-compatible service works (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
S3_BUCKET=
# Public URL prefix for stored objects, e.g. https://pub-xxxx.r2.dev
S3_PUBLIC_BASE_URL=
# Leave empty for AWS; for R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# e.g. us-east-2 for AWS, auto for R2
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave empty to use the bundled multiclass model (yolov8s-oiv7).
# Settings in the app selects species, not different model weights.
LIZARD_MODEL=
LIZARD_CONFIDENCE=0.25
# Optional writable directory for saved preferences. Empty uses backend/models.
# Docker keeps this state in a separate volume, leaving the bundled weights read-only.
DETECTRA_STATE_DIR=

# Live camera: an RTSP URL, credentials included, e.g. rtsp://USER:PASSWORD@192.168.1.170:554/stream1.
# It stays here only: the cameras table stores it without the credentials. A video file path works too.
CAMERA_RTSP_URL=
# Name for the camera's cameras row when it's first created
CAMERA_NAME=Camera
# Save a frame with detections at most once every N seconds (0 turns automatic saves off)
CAMERA_SAVE_INTERVAL=30
# ...and only when a detection is at least this confident (the live view shows from LIZARD_CONFIDENCE up)
CAMERA_SAVE_CONFIDENCE=0.5
# This API's address, used for the URLs of camera frames saved to backend/uploads
PUBLIC_API_URL=http://127.0.0.1:8000
